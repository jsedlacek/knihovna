{
  "name": "knihovna",
  "version": "1.0.0",
  "description": "Czech e-books static site",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "imports": {
    "#@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "wrangler:types": "wrangler types",
    "typecheck": "tsgo",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:imports && pnpm run format:check && pnpm test",
    "scrape": "node --env-file-if-exists=.env.local src/scripts/scrape-books.ts",
    "test": "LOG_LEVEL=silent node --test --test-reporter=./src/test/reporters/failures-only.ts src/**/*.test.ts",
    "test:verbose": "node --test --test-reporter=spec src/**/*.test.ts",
    "test:watch": "node --test --watch --test-reporter=spec src/**/*.test.ts",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "lint:imports": "node scripts/check-import-extensions.ts",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:screenshot": "node scripts/screenshot.ts",
    "storybook:stories": "node scripts/list-stories.ts"
  },
  "dependencies": {
    "@fontsource/libre-baskerville": "^5.3.0",
    "@jsedlacek/logtape-pretty": "^1.0.4",
    "@logtape/logtape": "^2.3.10",
    "@orama/orama": "^3.1.18",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/start-static-server-functions": "^1.167.39",
    "@types/lodash-es": "^4.17.12",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.49.0",
    "oxfmt": "^0.71.0",
    "p-map": "^7.0.8",
    "p-retry": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "wrangler": "^4.145.0",
    "yargs": "^18.2.0"
  },
  "engines": {
    "node": "24",
    "pnpm": "12"
  },
  "volta": {
    "node": "24.11.1"
  },
  "packageManager": "pnpm@12.8.1"
}
